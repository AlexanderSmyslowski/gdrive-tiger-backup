#!/bin/bash
set -u

PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

APP_PATH="/Applications/GDrive Backup Tiger.app"
SCRIPT_PATH="/usr/local/bin/backup-google-drive.sh"
AGENT_SOURCE="/usr/local/share/gdrive-tiger-backup/launchd/com.commcats.gdrivebackup.plist"

console_user="$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)"
if [[ -z "$console_user" || "$console_user" == "root" || "$console_user" == "loginwindow" ]]; then
  exit 0
fi

console_uid="$(/usr/bin/id -u "$console_user" 2>/dev/null || true)"
console_gid="$(/usr/bin/id -g "$console_user" 2>/dev/null || true)"
user_home="$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
if [[ -z "$console_uid" || -z "$console_gid" || -z "$user_home" || ! -d "$user_home" ]]; then
  exit 0
fi

agent_dir="$user_home/Library/LaunchAgents"
agent_dest="$agent_dir/com.commcats.gdrivebackup.plist"
config_dir="$user_home/.config/gdrive-tiger-backup"
config_file="$config_dir/config"
profiles_dir="$config_dir/profiles"
active_profile_file="$config_dir/active-profile"
new_install=0

/bin/mkdir -p "$agent_dir" "$config_dir" "$user_home/Library/Logs"
/usr/sbin/chown "$console_uid:$console_gid" "$agent_dir" "$config_dir" "$user_home/Library/Logs"

if [[ -L "$config_file" || ( -e "$config_file" && ! -f "$config_file" ) ]]; then
  echo "The legacy configuration is not a trusted regular file." >&2
  exit 73
fi

if [[ -f "$AGENT_SOURCE" ]]; then
  /usr/bin/install -m 644 "$AGENT_SOURCE" "$agent_dest"
  /usr/libexec/PlistBuddy -c 'Delete :EnvironmentVariables' "$agent_dest" >/dev/null 2>&1 || true
  /usr/libexec/PlistBuddy -c 'Add :EnvironmentVariables dict' "$agent_dest"
  /usr/libexec/PlistBuddy -c "Add :EnvironmentVariables:HOME string $user_home" "$agent_dest"
  /usr/libexec/PlistBuddy -c 'Add :EnvironmentVariables:PATH string /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin' "$agent_dest"
  /usr/sbin/chown "$console_uid:$console_gid" "$agent_dest"

  /bin/launchctl bootout "gui/$console_uid" "$agent_dest" >/dev/null 2>&1 || true
  /bin/launchctl bootstrap "gui/$console_uid" "$agent_dest" >/dev/null 2>&1 || true
  /bin/launchctl enable "gui/$console_uid/com.commcats.gdrivebackup" >/dev/null 2>&1 || true
fi

if [[ ! -f "$config_file" ]]; then
  new_install=1
  {
    printf 'GDRIVE_BACKUP_TARGET=apfs\n'
    printf 'GDRIVE_BACKUP_VOLUME=/Volumes/GoogleDrive-Backup\n'
    printf 'GDRIVE_BACKUP_VOLUME_NAME=GoogleDrive-Backup\n'
    printf 'RCLONE_REMOTE=gdrive\n'
    printf 'GDRIVE_BACKUP_LANG=auto\n'
    printf 'GDRIVE_BACKUP_CONFIRM=1\n'
    printf 'GDRIVE_BACKUP_AUTO_CREATE_VOLUME=1\n'
    printf 'GDRIVE_BACKUP_VERSIONING=1\n'
    printf 'GDRIVE_BACKUP_VERSIONS_SUBDIR=.gdrive-versions\n'
    printf 'GDRIVE_BACKUP_RETENTION=1\n'
    printf 'GDRIVE_BACKUP_ENCRYPTION=none\n'
    printf 'GDRIVE_BACKUP_PAUSED=0\n'
    printf 'GDRIVE_BACKUP_NOTIFY_FAILURES=1\n'
    printf 'GDRIVE_BACKUP_NOTIFY_SUCCESSES=0\n'
    printf 'GDRIVE_BACKUP_SCHEDULE=manual\n'
  } >"$config_file"
fi
if [[ -f "$config_file" ]] && ! /usr/bin/grep -q '^GDRIVE_BACKUP_PAUSED=' "$config_file"; then
  printf 'GDRIVE_BACKUP_PAUSED=0\n' >>"$config_file"
fi
if [[ -f "$config_file" ]] && ! /usr/bin/grep -q '^GDRIVE_BACKUP_NOTIFY_FAILURES=' "$config_file"; then
  printf 'GDRIVE_BACKUP_NOTIFY_FAILURES=1\n' >>"$config_file"
fi
migrate_success_notification_preference() {
  local target="$1"
  local temporary_config
  if [[ ! -f "$target" || -L "$target" ]]; then
    echo "Refusing to update an untrusted configuration file: $target" >&2
    return 73
  fi
  if /usr/bin/grep -q '^GDRIVE_BACKUP_NOTIFY_SUCCESSES=' "$target"; then
    return
  fi
  temporary_config="$(/usr/bin/mktemp "${target}.successes.XXXXXX")" || return
  /bin/cp -p "$target" "$temporary_config" || return
  if [[ -s "$temporary_config" &&
        "$(/usr/bin/tail -c 1 "$temporary_config" | /usr/bin/od -An -tx1 | /usr/bin/tr -d '[:space:]')" != "0a" ]]; then
    printf '\n' >>"$temporary_config" || return
  fi
  printf 'GDRIVE_BACKUP_NOTIFY_SUCCESSES=0\n' >>"$temporary_config" || return
  /bin/mv "$temporary_config" "$target"
}

trusted_active_profile_config() {
  local profile_id profile_config profile_line profile_id_assignments=0
  if [[ ! -f "$active_profile_file" || -L "$active_profile_file" ]]; then
    echo "The active profile pointer is not a trusted regular file." >&2
    return 73
  fi
  profile_id="$(<"$active_profile_file")"
  if [[ ! "$profile_id" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ||
        ! -d "$profiles_dir" || -L "$profiles_dir" ]]; then
    echo "The active profile store is not trusted." >&2
    return 73
  fi
  profile_config="$profiles_dir/$profile_id.conf"
  if [[ ! -f "$profile_config" || -L "$profile_config" ]]; then
    echo "The active profile configuration is not a trusted regular file." >&2
    return 73
  fi
  while IFS= read -r profile_line || [[ -n "$profile_line" ]]; do
    case "$profile_line" in
      "GDRIVE_BACKUP_PROFILE_ID=$profile_id"|"GDRIVE_BACKUP_PROFILE_ID='$profile_id'"|"GDRIVE_BACKUP_PROFILE_ID=\"$profile_id\"")
        profile_id_assignments=$((profile_id_assignments + 1))
        ;;
      GDRIVE_BACKUP_PROFILE_ID=*)
        echo "The active profile identity does not match its file name." >&2
        return 73
        ;;
    esac
  done <"$profile_config"
  if [[ "$profile_id_assignments" != "1" ]]; then
    echo "The active profile identity does not match its file name." >&2
    return 73
  fi
  printf '%s' "$profile_config"
}

active_profile_config=""
migrate_notification_success_preferences() {
  if [[ ! -f "$config_file" || -L "$config_file" ]]; then
    echo "The legacy configuration is not a trusted regular file." >&2
    return 73
  fi
  active_profile_config=""
  if [[ -e "$active_profile_file" || -L "$active_profile_file" ]]; then
    active_profile_config="$(trusted_active_profile_config)" || return
  fi
  migrate_success_notification_preference "$config_file" || return
  if [[ -n "$active_profile_config" ]]; then
    migrate_success_notification_preference "$active_profile_config" || return
  fi
}

migrate_notification_success_preferences || exit $?
/bin/chmod 600 "$config_file"
/usr/sbin/chown "$console_uid:$console_gid" "$config_file"

if [[ -d "$APP_PATH" && -x "$SCRIPT_PATH" ]]; then
  if [[ "$new_install" == "1" ]]; then
    /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" /usr/bin/open -n "$APP_PATH" --args --setup >/dev/null 2>&1 || true
  fi
fi

exit 0
